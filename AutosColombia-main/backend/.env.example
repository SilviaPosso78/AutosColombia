# Ejemplos: completa backend/.env con tus datos locales. No publiques ese archivo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=autos_colombia
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASENA
DB_CONNECT_TIMEOUT=5

# WhatsApp Business Cloud API. Credenciales privadas en backend/.env.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v27.0
WHATSAPP_PHONE_NUMBER_ID=CAMBIAR_IDENTIFICADOR
WHATSAPP_ACCESS_TOKEN=CAMBIAR_TOKEN
WHATSAPP_TEMPLATE_NAME=recordatorio_mensualidad
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_APP_SECRET=CAMBIAR_SECRETO_APP
WHATSAPP_VERIFY_TOKEN=CAMBIAR_TOKEN_VERIFICACION
